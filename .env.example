# Режим окружения: development | production
NODE_ENV=production

# Порт приложения
PORT=3000

# Режим демонстрационных данных (true/false)
NEXT_PUBLIC_ENABLE_MOCK_FALLBACK=true

# Базовый домен e-schools по умолчанию (например, https://schools.by)
ESCHOOLS_BASE_URL=https://schools.by

# Таймаут запросов к e-schools в миллисекундах
ESCHOOLS_REQUEST_TIMEOUT=15000
